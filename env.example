# Copy to .env for local use (the app reads real environment variables; use `export` or a tool like dotenv-cli)
PORT=3000
APP_TZ=Asia/Kolkata
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_NAME=Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
# Leave DATABASE_URL empty locally -> uses an embedded Postgres in ./data
# DATABASE_URL=postgres://user:pass@host:5432/dbname
